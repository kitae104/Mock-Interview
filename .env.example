# 복사해서 사용하세요: cp .env.example .env
# 프로젝트마다 다른 이름을 쓰세요. 컨테이너·네트워크·볼륨 이름의 접두어가 됩니다.
COMPOSE_PROJECT_NAME=mock-interview

DB_NAME=mock_interview
DB_USERNAME=mock_interview
DB_PASSWORD=mock_interview
DB_PORT=5432

# 32바이트 이상의 임의 문자열. 예: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-please-32bytes-or-more
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600

# 같은 PC에서 여러 프로젝트를 동시에 띄우면 포트가 겹치지 않게 바꾸세요.
BACKEND_PORT=8080
FRONTEND_PORT=3000
# 프론트엔드를 다른 출처(도메인)에서 띄울 때만 지정하세요. 비워 두면 http://localhost:<FRONTEND_PORT> 와 로컬 개발 서버(5173)를 허용합니다.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI 채팅 (OpenAI). 키가 비어 있으면 채팅 요청만 502 로 실패합니다.
# OpenAI 호환 서버(Groq, Together, vLLM, LM Studio 등)를 쓰려면 OPENAI_BASE_URL 과 모델 이름을 바꾸세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 모의 면접 답변 음성을 텍스트로 바꾸는 모델 (같은 OPENAI_API_KEY 를 씁니다. 키가 없으면 답변 업로드가 502 로 실패합니다).
OPENAI_STT_MODEL=whisper-1
# AI 응답이 잘리지 않게 넉넉히 둡니다. 면접 질문 10개 생성이나 긴 피드백(JSON)은 한국어로 3천 토큰 안팎입니다.
AI_MAX_TOKENS=4096

# 모의 면접 한도 (docs/PLAN.md 9장). 지정하지 않으면 아래 값을 씁니다.
# INTERVIEW_MAX_ANSWER_SECONDS=120
# INTERVIEW_MAX_AUDIO_MB=25
# INTERVIEW_DAILY_LIMIT=20
# INTERVIEW_AI_RATE_PER_MINUTE=20
# INTERVIEW_DEFAULT_PREP_SECONDS=10
# INTERVIEW_CONSENT_VERSION=2026-10-v1
